[mysqld]
# The original servers ran on Windows MySQL: code uses mixed-case table names (guildMember, ...)
lower_case_table_names = 1
character-set-server   = utf8mb4
collation-server       = utf8mb4_general_ci
# Lenient mode, as the old game code expects (implicit defaults, zero dates)
sql_mode               = NO_ENGINE_SUBSTITUTION
max_connections        = 500
default-time-zone      = '+07:00'

[client]
default-character-set = utf8mb4
