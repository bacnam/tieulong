# Copy to .env and edit before `docker compose up -d --build`

# MySQL root password (used by all services)
MYSQL_ROOT_PASSWORD=change-me

# Web portal secret (Lumen APP_KEY, used to sign login tokens). Any random 32-char string:
#   openssl rand -hex 16
APP_KEY=change-me-32-chars-random-string

# Host name / IP that players' browsers use to reach this machine.
# localhost = only this computer; use the LAN IP or domain to let others play.
GAME_PUBLIC_HOST=localhost

# Published ports
WEB_PORT=8080
GAME_CLIENT_PORT=8501
MYSQL_PORT=3306

# Game server identity
GAME_SERVER_ID=1
GAME_SERVER_NAME=Dương Quá
GAME_OPEN_TIME=2023-09-29 11:00:00

TZ=Asia/Ho_Chi_Minh
#GAME_JAVA_OPTS=-Xms512m -Xmx1024m -Xss228k
#WORLD_JAVA_OPTS=-Xms256m -Xmx512m -Xss228k
