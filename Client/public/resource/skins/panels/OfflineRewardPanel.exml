			<e:Label text="Thời gian: " x="54" y="340" size="24" textAlign="right" strokeColor="0x000000" stroke="1"
			         textColor="0xFDB200" width="130" height="29" verticalAlign="middle" scaleX="1" scaleY="1" anchorOffsetX="0" />
			<e:Image source="smallui_tbg_png" y="19" scaleX="1" scaleY="1" x="107" />
			<e:Label text="Thưởng Offline" y="23" size="24" textAlign="center" strokeColor="0x5E3500" stroke="1" width="205" height="32"
