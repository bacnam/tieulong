		<e:Image source="form_jbg_png" scale9Grid="13,14,24,22" y="584.33" width="360" height="110"
			scaleX="1" scaleY="1" anchorOffsetX="0" anchorOffsetY="0" horizontalCenter="0" />
		<e:Label text="Thuộc tính:" x="128" y="596.34" size="18" textAlign="right"
			strokeColor="0x000000" stroke="1" anchorOffsetX="0" anchorOffsetY="0"
			textColor="0xF8F7D3" bold="true" />
		<e:Scroller height="89" y="595" anchorOffsetX="0" anchorOffsetY="0" horizontalCenter="55"
			width="235">
			<e:List id="list_Attr" scaleX="1" scaleY="1" y="16" anchorOffsetY="0" x="-1"
				anchorOffsetX="0" width="236">
				<e:itemRendererSkinName>
					<e:Skin>
						<e:Label text="{data}" size="21" textAlign="left" strokeColor="0x000000"
							stroke="1" textColor="0xF8F7D3" />
					</e:Skin>
				</e:itemRendererSkinName>
				<e:ArrayCollection>
					<e:Array>
						<e:Object null="" />
						<e:Object null="" />
						<e:Object null="" />
						<e:Object null="" />
						<e:Object null="" />
					</e:Array>
				</e:ArrayCollection>
				<e:layout>
					<e:VerticalLayout gap="1" />
				</e:layout>
			</e:List>
		</e:Scroller>
		<e:Image source="line_png" y="323" width="550" height="2" horizontalCenter="0.5" />
		<e:Scroller width="540" height="252" y="68.02" anchorOffsetX="0" anchorOffsetY="0"
			horizontalCenter="0">
			<e:List id="list">
				<e:itemRendererSkinName>
					<e:Skin states="up,down,disabled" width="180" height="252">
						<e:Image id="icon" width="180" height="252" source="wingbanner_01_jpg"
							horizontalCenter="0" verticalCenter="0" touchEnabled="false" />
						<e:Image width="100%" height="100%" source.down="light_png"
							horizontalCenter="0" verticalCenter="0" />
					</e:Skin>
				</e:itemRendererSkinName>
				<e:layout>
					<e:HorizontalLayout gap="0" />
				</e:layout>
			</e:List>
		</e:Scroller>
		<e:Image id="btn_close" source="btn_close_png" y="13" scaleX="1" scaleY="1" x="516.33" />
		<e:Image id="tittle" y="7.01" scaleX="1" scaleY="1" horizontalCenter="0" source="wing_png" />
		<e:Image id="btn_close1" x="530" y="802" source="btn_close_2_png" anchorOffsetX="0"
			anchorOffsetY="0" scaleX="1" scaleY="1" />
		<component:Power id="power" y="340.5" skinName="Power" horizontalCenter="-0.5" />
