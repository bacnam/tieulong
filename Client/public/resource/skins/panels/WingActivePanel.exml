<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="WingActivePanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui"
	xmlns:w="http://ns.egret.com/wing" xmlns:component="legend.view.component.*"
	xmlns:panels="legend.panels.*">
	<e:Group width="591" height="847" horizontalCenter="0" verticalCenter="0">
		<e:Image source="ui_bg_png" scaleX="1" scaleY="1" touchEnabled="false" />
		<e:Image id="frombg" source="form_bg_png" width="550" height="753" scale9Grid="16,15,19,18"
			scaleX="1" scaleY="1" y="61" anchorOffsetY="0" horizontalCenter="1.5" />
		<e:Image source="form_inbg_png" scale9Grid="14,36,23,4" y="329.67" anchorOffsetX="0"
			width="531.34" anchorOffsetY="0" height="473.67" horizontalCenter="0" />
		<e:Image source="list_bg_jpg" y="335.33" anchorOffsetY="0" height="460.67" anchorOffsetX="0"
			width="521.83" horizontalCenter="0.5" />
		<e:Image id="wingIcon" scaleX="1" scaleY="1" anchorOffsetX="256" anchorOffsetY="256"
			source="bigwing_1_png" verticalCenter="196.5" horizontalCenter="0" />
		<e:Image id="btn_active" source="btn_bg4_png" scale9Grid="5,5,110,34" y="744" width="114"
			anchorOffsetX="0" horizontalCenter="0" />
		<e:Image id="bg_discount" source="zhekou_png" x="205" y="735" touchEnabled="false" />
		<e:BitmapLabel id="discount" text="8" y="742.76" verticalAlign="middle"
			horizontalCenter="-68.5" font="shop_number_fnt" scaleX="0.48" scaleY="0.48"
