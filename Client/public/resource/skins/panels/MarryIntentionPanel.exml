<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="MarryIntentionPanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing">
	<e:Group width="591" height="847" horizontalCenter="0" verticalCenter="0">
		<e:Image source="ui_bg_png" scaleX="1" scaleY="1" touchEnabled="false" x="0" y="0"/>
		<e:Image source="form_bg_png" width="550" height="744" scale9Grid="16,15,19,18" scaleX="1" scaleY="1" anchorOffsetY="0" y="67.31" horizontalCenter="0.5"/>
		<e:Image source="list_bg_jpg" y="75" anchorOffsetX="0" width="531" anchorOffsetY="0" height="723" horizontalCenter="0"/>
		<e:Image name="btn_close" source="btn_close_png" y="15" scaleX="1" scaleY="1" x="515"/>
		<e:Image y="5.35" scaleX="1" scaleY="1" horizontalCenter="0.5" source="xialv_png"/>
		<e:Group id="group_one" width="531" height="682" horizontalCenter="0" verticalCenter="0">
			<e:Image source="ui_tit_bg_png" y="3.33" anchorOffsetY="0" height="62.34" anchorOffsetX="0" width="505.33" horizontalCenter="0" x="12" scaleX="1" scaleY="1"/>
			<e:Label text="收到的求婚意向:  " y="15" size="22" strokeColor="0x000000" stroke="1" verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0" x="25" anchorOffsetY="0" textColor="0xFF0000" bold="true"/>
			<e:Label id="apply_tip" text="30分钟后，若无处理求婚意向，意向将消失" y="15" size="22" strokeColor="0x000000" stroke="1" width="320" height="48" verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0" anchorOffsetY="0" textColor="0xFDFFDD" x="195" scaleX="1" scaleY="1" textAlign="left"/>
			<e:Image source="ui_tit_bg_png" y="341.33" anchorOffsetY="0" height="62.34" anchorOffsetX="0" width="505.33" scaleX="1" scaleY="1" horizontalCenter="0"/>
			<e:Label id="send_tip" text="30分钟后，若对方无法反应或拒绝将清除求婚意向" y="350" size="22" strokeColor="0x000000" stroke="1" width="320" height="48" verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0" x="195" anchorOffsetY="0" textColor="0xFDFFDD" lineSpacing="5"/>
			<e:Label text="发出的求婚意向:  " y="350" size="22" strokeColor="0x000000" stroke="1" verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0" x="25" anchorOffsetY="0" textColor="0x00FF00" bold="true"/>
			<e:Scroller width="508" height="270" y="68" anchorOffsetX="0" anchorOffsetY="0" horizontalCenter="0" x="11" scaleX="1" scaleY="1">
			<e:List id="list_received" itemRendererSkinName="MarryIntentionItem">
				<e:layout>
				<e:VerticalLayout horizontalAlign="center" gap="5"/>
				</e:layout>
			</e:List>
			</e:Scroller>
			<e:Scroller width="508" height="270" y="407" anchorOffsetX="0" anchorOffsetY="0" horizontalCenter="0" x="11" scaleX="1" scaleY="1">
			<e:List id="list_send" y="-1" itemRendererSkinName="MarryIntentionItem">
				<e:layout>
				<e:VerticalLayout gap="5" horizontalAlign="center"/>
				</e:layout>
			</e:List>
			</e:Scroller>
		</e:Group>
		<e:Group id="group_two" width="531" height="682" horizontalCenter="0" verticalCenter="0" x="10" y="10">
			<e:Image source="ui_tit_bg_png" y="6.989999999999998" anchorOffsetY="0" height="39.34" anchorOffsetX="0" width="505.33" horizontalCenter="-0.5" x="12" scaleX="1" scaleY="1"/>
			<e:Label text="收到的离婚请求: " y="12.3" size="22" strokeColor="0x000000" stroke="1" width="250.66" height="31.33" verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0" x="19.339999999999996" anchorOffsetY="0" textColor="0xFFFBC4" scaleX="1" scaleY="1"/>
			<e:Scroller width="508" height="630" y="48.3" anchorOffsetY="0" horizontalCenter="0.5">
			<e:List id="list_divorce" itemRendererSkinName="MarryIntentionItem">
				<e:layout>
				<e:VerticalLayout horizontalAlign="center"/>
				</e:layout>
			</e:List>
			</e:Scroller>
		</e:Group>




		<e:Image id="btn_close1" x="535" y="800" source="btn_close_2_png" name="btn_close" anchorOffsetX="0" anchorOffsetY="0"/>

	</e:Group>
</e:Skin>