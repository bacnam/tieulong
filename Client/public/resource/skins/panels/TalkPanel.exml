<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="TalkPanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui"
        xmlns:component="legend.view.component.*" xmlns:panels="legend.panels.*" xmlns:w="http://ns.egret.com/wing">
	<e:Group width="597" height="840" anchorOffsetX="0" anchorOffsetY="0" touchEnabled="false" horizontalCenter="0"
	         verticalCenter="0">
		<e:Image source="ui_bg_png" scaleX="1" scaleY="1" y="-7" horizontalCenter="0" x="2" />
		<e:Image name="btn_close" source="btn_close_png" y="2.9399999999999977" scaleX="1" scaleY="1" x="518.93" />
		<e:Image id="tittle" y="0.27000000000001023" scaleX="1" scaleY="1" horizontalCenter="0" source="talk2_png" x="260" />
		<e:Image id="btn_close1" x="535" y="800" source="btn_close_2_png" name="btn_close" anchorOffsetX="0" anchorOffsetY="0" />
		<e:ViewStack id="content_View" width="550" height="697" scaleX="1" scaleY="1" horizontalCenter="0" x="23"
		             touchEnabled="false" selectedIndex="1" verticalCenter="-9" y="63">
			<e:Group name="Thế giới" width="100%" height="100%" anchorOffsetY="0" touchEnabled="false" visible="false">
				<e:Image source="form_bg_png" scale9Grid="16,15,19,18" scaleX="1" scaleY="1" width="550" height="625"
				         horizontalCenter="0" />
				<e:Image source="form_bg_png" scale9Grid="16,15,19,18" y="623.81" scaleX="1" scaleY="1" width="550" height="75"
				         horizontalCenter="0" />
				<e:Image source="form_zibg_png" scale9Grid="5,5,30,30" x="20" y="642.83" width="422" scaleX="1" scaleY="1" />
				<e:Image id="send_allworld" source="btn_bg5_png" scale9Grid="3,2,82,32" x="450" y="644.33" scaleX="1" scaleY="1" />
				<e:Label id="label_allworld" text="Gửi" y="651.33" size="22" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3"
				         scaleX="1" scaleY="1" touchEnabled="false" horizontalCenter="223" />
				<e:Scroller anchorOffsetY="0" height="600" width="530" horizontalCenter="0" y="10">
					<e:List id="list_allworld" width="100%" itemRendererSkinName="TalkIngItemRender" />
				</e:Scroller>
				<e:TextInput id="input_allworld" x="25" y="645" skinName="skins.TextInputSkin" height="35" anchorOffsetX="0"
				             width="410" textColor="0xffffff" prompt="Nhập nội dung trò chuyện" />
			</e:Group>
			<e:Group name="Bang" width="100%" height="100%" anchorOffsetY="0" touchEnabled="false" visible="false">
				<e:Image source="form_bg_png" scale9Grid="16,15,19,18" scaleX="1" scaleY="1" width="550" height="625"
				         horizontalCenter="0" />
				<e:Image source="form_bg_png" scale9Grid="16,15,19,18" y="623.81" scaleX="1" scaleY="1" width="550" height="75"
				         horizontalCenter="0" />
				<e:Image source="form_zibg_png" scale9Grid="5,5,30,30" x="20" y="642.83" width="422" scaleX="1" scaleY="1" />
				<e:Image id="send_guild" source="btn_bg5_png" scale9Grid="3,2,82,32" x="450" y="644.33" scaleX="1" scaleY="1" />
				<e:Label id="label_guild" text="Gửi" y="651.33" size="22" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3"
				         scaleX="1" scaleY="1" touchEnabled="false" horizontalCenter="223" />
				<e:Scroller anchorOffsetY="0" height="600" width="530" horizontalCenter="0" y="10">
					<e:List id="list_guild" width="100%" itemRendererSkinName="TalkIngItemRender" />
				</e:Scroller>
				<e:TextInput id="input_guild" x="25" y="645" skinName="skins.TextInputSkin" height="35" anchorOffsetX="0"
				             width="410" textColor="0xffffff" prompt="Nhập nội dung trò chuyện" />
			</e:Group>
			<e:Group width="100%" height="100%" name="Hệ thống">
				<e:Image source="form_bg_png" scale9Grid="16,15,19,18" scaleX="1" scaleY="1" width="550" height="624.5"
				         horizontalCenter="0" anchorOffsetY="0" />
				<e:Scroller anchorOffsetY="0" height="598.5" width="530" horizontalCenter="0" y="10">
					<e:List id="list_system" width="100%" anchorOffsetY="0" itemRendererSkinName="TalkIngItemRender">
						<e:itemRendererSkinName>
							<e:Skin>
								<e:Label id="content" text="Hệ thống" x="122" y="36" size="20" textAlign="left" width="402" textColor="0xFFFFFF"
								         height="81" anchorOffsetX="0" anchorOffsetY="0" />
								<e:Label id="label_name" text="Hệ thống" x="122" y="5" size="28" textAlign="left" bold="true" height="30"
								         verticalAlign="middle" textColor="0xff0000" />
								<e:Image source="line_png" y="118" width="525" horizontalCenter="0" />
								<e:Image source="portrait_bg_png" x="22.33" y="11.67" />
								<e:Image id="img_icon" x="29.31" y="20.32" width="76" height="76" source="s_portrait012_png" />
								<e:Label id="label_sendtime" text="2017 01-05-03" y="12" size="18" textAlign="left" strokeColor="0x000000"
								         stroke="1" textColor="0xC5D9EA" verticalAlign="middle" anchorOffsetX="0" right="5" />
							</e:Skin>
						</e:itemRendererSkinName>
					</e:List>
				</e:Scroller>
				<e:Image source="form_bg_png" scale9Grid="16,15,19,18" y="624.64" scaleX="1" scaleY="1" width="550" height="75"
				         horizontalCenter="0" />
				<e:Label text="Kênh hệ thống không thể nói, vui lòng chuyển sang kênh khác để nói." y="641.33" size="22" textAlign="center" strokeColor="0x000000" stroke="1"
				         textColor="0xF8F7D3" width="521" height="44" verticalAlign="middle" scaleX="1" scaleY="1"
				         horizontalCenter="0" />
			</e:Group>
			<e:Group id="gm_group" name="GM" width="100%" height="100%" anchorOffsetY="0" touchEnabled="false" visible="false">
				<e:Image source="form_bg_png" scale9Grid="16,15,19,18" scaleX="1" scaleY="1" width="550" height="625"
				         horizontalCenter="0" />
				<e:Image source="form_bg_png" scale9Grid="16,15,19,18" y="623.81" scaleX="1" scaleY="1" width="550" height="75"
				         horizontalCenter="0" />
				<e:Image source="form_zibg_png" scale9Grid="5,5,30,30" x="20" y="642.83" width="422" scaleX="1" scaleY="1" />
				<e:Image id="send_gm" source="btn_bg5_png" scale9Grid="3,2,82,32" x="450" y="644.33" scaleX="1" scaleY="1" />
				<e:Label id="label_gm" text="Gửi" y="651.33" size="22" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3"
				         scaleX="1" scaleY="1" touchEnabled="false" horizontalCenter="223" />
				<e:Scroller anchorOffsetY="0" height="600" width="530" horizontalCenter="0" y="10">
					<e:List id="list_gm" width="100%" itemRendererSkinName="TalkIngItemRender" />
				</e:Scroller>
				<e:TextInput id="input_gm" x="25" y="645" skinName="skins.TextInputSkin" height="35" anchorOffsetX="0"
				             width="410" textColor="0xffffff" prompt="Nhập nội dung trò chuyện" />
			</e:Group>
		</e:ViewStack>
		<e:TabBar id="tabBar_page" dataProvider="{content_View}" scaleX="1" scaleY="1"
		          selectedIndex="0" horizontalCenter="0" x="174" y="761"  itemRendererSkinName="Button_funcSkin1"/>
	</e:Group>
	<component:EuiMap id="panelData">
		<e:Array>
			<e:Object name="CHATTYPE_WORLD" list="list_allworld" input="input_allworld" send="send_allworld" sendLabel="label_allworld" />
			<e:Object name="CHATTYPE_GUILD" list="list_guild" input="input_guild" send="send_guild" sendLabel="label_guild" />
			<e:Object name="CHATTYPE_SYSTEM" list="list_system" input="" send="" />
			<e:Object name="CHATTYPE_GM" list="list_gm" input="input_gm" send="send_gm" sendLabel="label_gm" />
		</e:Array>
	</component:EuiMap>
	<component:EuiMap id="reddotMap">
		<e:Array>
			<e:Object name="3" event="GMTalk" />
		</e:Array>
	</component:EuiMap>
</e:Skin>