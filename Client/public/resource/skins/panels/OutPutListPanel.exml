<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="OutPutListPanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui"
    xmlns:w="http://ns.egret.com/wing">
    <e:Group width="504" height="612" touchEnabled="false" anchorOffsetX="0" anchorOffsetY="0"
        horizontalCenter="0"
        verticalCenter="0">
        <e:Group width="504" height="612" touchEnabled="false" anchorOffsetX="0" anchorOffsetY="0"
            x="0" y="0"
            scaleX="1" scaleY="1">
            <e:Image source="smallui_bg_png" scale9Grid="74,32,53,47" width="500" height="610"
                horizontalCenter="0"
                verticalCenter="0" x="2" y="1" scaleX="1" scaleY="1" />
            <e:Image source="form_bg_png" scale9Grid="16,15,19,18" y="67" width="440" height="372"
                scaleX="1" scaleY="1"
                horizontalCenter="1" x="33" />
            <e:Image source="list_tab_png" y="443" horizontalCenter="0" height="155" width="415"
                x="45" scaleX="1"
                scaleY="1" />
            <e:Image source="btn_close_png" x="433" y="1" name="btn_close" scaleX="1" scaleY="1" />
            <e:Image source="smallui_tbg_png" y="16" scaleX="1" scaleY="1" x="106" />
            <e:Label text="Bảng xếp hạng" y="20" size="22" textAlign="center" strokeColor="0x5E3500"
                stroke="1" width="205"
                height="32" fontFamily="Arial" textColor="0xF7F397" verticalAlign="middle" x="150"
                scaleX="1"
                scaleY="1" />
            <e:Label text="Hạng nhất:" x="69" y="466" size="20" textAlign="right"
                strokeColor="0x000000" stroke="1"
                textColor="0xFFC446" width="144" height="30" verticalAlign="middle" scaleX="1"
                scaleY="1" />
            <e:Label text="Kết thúc BOSS:" x="69" y="494" size="20" textAlign="right"
                strokeColor="0x000000" stroke="1"
                textColor="0xFFC446" width="144" height="30" verticalAlign="middle" scaleX="1"
                scaleY="1" />
            <e:Label text="Hạng của bạn:" x="69" y="524" size="20" textAlign="right"
                strokeColor="0x000000" stroke="1"
                textColor="0xFFC446" width="144" height="30" verticalAlign="middle" scaleX="1"
                scaleY="1" />
            <e:Label text="Sát thương:" x="69" y="554" size="20" textAlign="right"
                strokeColor="0x000000" stroke="1"
                textColor="0xFFC446" width="144" height="30" verticalAlign="middle" scaleX="1"
                scaleY="1" />
        </e:Group>
        <e:Label text="Hạng" x="47" y="78" size="20" textAlign="right"
            strokeColor="0x8B1725" stroke="2" width="50"
            textColor="0xFCE795" scaleX="1" scaleY="1" />
        <e:Label text="Tên" x="97" y="78" size="22"
            textAlign="center"
            strokeColor="0x000000" stroke="1" textColor="0xFEFEFE" width="252"
            height="30"
            verticalAlign="middle" />
        <e:Label right="47" y="78" size="22" textAlign="right" strokeColor="0x000000"
            stroke="1"
            textColor="0xFEFEFE" width="252" height="30" verticalAlign="middle"
            text="Sát thương" />
        <e:Image source="line_png" y="108" width="430" x="37" />
        <e:Scroller width="414" height="317" y="108" anchorOffsetX="0" anchorOffsetY="0" x="47">
            <e:List id="list" width="414" x="7" y="-257">
                <e:itemRendererSkinName>
                    <e:Skin width="414">
                        <e:Label text="{data.rank}" left="7" y="5" size="26" textAlign="right"
                            strokeColor="0x8B1725" stroke="2"
                            textColor="0xFCE795" scaleX="1" scaleY="1" />
                        <e:Label text="{data.players.name}" left="47" y="5" size="22"
                            textAlign="center"
                            strokeColor="0x000000" stroke="1" textColor="0xFEFEFE" width="252"
                            height="30"
                            verticalAlign="middle" />
                        <e:Label left="217" y="10" size="22" textAlign="left" strokeColor="0x000000"
                            stroke="1"
                            verticalAlign="middle" anchorOffsetX="0" text=""
                            textColor="0x00ff00" />
                        <e:Label right="7" y="5" size="22" textAlign="right" strokeColor="0x000000"
                            stroke="1"
                            textColor="0xFEFEFE" width="352" height="30" verticalAlign="middle"
                            text="{data.damage}" />
                        <e:Image source="line_png" y="46" width="400" x="8" />
                    </e:Skin>
                </e:itemRendererSkinName>
                <e:layout>
                    <e:VerticalLayout gap="0" horizontalAlign="center" verticalAlign="bottom" />
                </e:layout>
            </e:List>
        </e:Scroller>
        <e:Label id="first_name" text="s.170 我的角色名很长" x="216" y="466" size="20" textAlign="left"
            strokeColor="0x000000"
            stroke="1" textColor="0xF8F7D3" width="275" height="30" verticalAlign="middle" />
        <e:Label id="kill" text="无" x="216" y="494" size="20" textAlign="left"
            strokeColor="0x000000" stroke="1"
            textColor="0xF8F7D3" width="275" height="30" verticalAlign="middle" />
        <e:Label id="my_rank" text="1234567890123" x="216" y="524" size="20" textAlign="left"
            strokeColor="0x000000"
            stroke="1" textColor="0xF8F7D3" width="414" height="30" verticalAlign="middle" />
        <e:Label id="my_output" text="1234567890123" x="216" y="554" size="20" textAlign="left"
            strokeColor="0x000000"
            stroke="1" textColor="0xF8F7D3" width="414" height="30" verticalAlign="middle" />
    </e:Group>
</e:Skin>