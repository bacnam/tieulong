<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="VipPanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui"
    xmlns:w="http://ns.egret.com/wing"
    xmlns:component="legend.view.component.*">
    <e:Group width="600" height="847" horizontalCenter="0" verticalCenter="0" touchEnabled="false">
        <e:Group width="600" height="847" horizontalCenter="0" verticalCenter="0" x="0" y="0"
            scaleX="1" scaleY="1"
            touchEnabled="false">
            <e:Image source="ui_shop_bg_png" horizontalCenter="0" x="0" scaleX="1" scaleY="1" />
            <e:Image source="btn_close_1_png" x="546.34" y="26.01" scaleX="1" scaleY="1"
                name="btn_close" />
            <e:Image source="vip_png" y="11.33" scaleX="1" scaleY="1" horizontalCenter="0" />
            <e:Image source="shop_inbg_png" y="475.34" scaleX="1" scaleY="1" width="540"
                height="338.33"
                scale9Grid="5,36,40,6" anchorOffsetY="0" x="30" />


            <e:Image source="shop_titbg_png" y="429.34" scaleX="1" scaleY="1" horizontalCenter="0" />
            <e:Image id="btn_recharge" source="btn_bg3_png" x="350" y="165" width="194" height="50"
                scaleX="1" scaleY="1"
            />
            <e:Label text="Nạp thẻ" x="387" y="175" size="22" textAlign="center"
                strokeColor="0x000000" stroke="1"
                textColor="0xFFC446" width="120" height="30" verticalAlign="middle" scaleX="1"
                scaleY="1"
                touchEnabled="false" />
            <e:Image source="ui_vip_png" x="50" y="114" scaleX="1" scaleY="1" />
            <e:Image source="shop_bar_bg_png" y="227" width="480" horizontalCenter="1" x="61"
                scaleX="1" scaleY="1" />
        </e:Group>
        <e:Label text="Lưu ý: Đặc quyền VIP không cộng dồn." x="0" y="485" size="22" textAlign="center"
            strokeColor="0x000000" stroke="1"
            textColor="0xFFC446" width="515" height="30" verticalAlign="middle" scaleX="1"
            scaleY="1"
            touchEnabled="false" />
        <e:Scroller width="515" height="285.67" x="40" y="515" anchorOffsetX="0" anchorOffsetY="0">
            <e:List id="list" width="100%" y="108" anchorOffsetY="0" height="286.67" x="10">
                <e:itemRendererSkinName>
                    <e:Skin>
                        <e:Label id="label" size="20" textAlign="left" strokeColor="0x000000"
                            stroke="1"
                            textColor="0xF8F7D3" height="22" verticalAlign="middle" />
                    </e:Skin>
                </e:itemRendererSkinName>
                <e:layout>
                    <e:VerticalLayout />
                </e:layout>
            </e:List>
        </e:Scroller>
        <e:Image id="lingqu" y="385.34" scaleX="1" scaleY="1" horizontalCenter="0"
            source="lingqu_png" touchEnabled="false" />
        <component:Button_Get id="btn_get" y="385" skinName="Button_Get" width="100" height="40"
            horizontalCenter="0" />
        <e:BitmapLabel id="cur_vip" x="150" y="109" scaleX="1" scaleY="1" font="vip_number_fnt"
            text="0" />
        <e:Component id="effectbg" width="20" height="20" scaleX="1" scaleY="1" anchorOffsetX="10"
            anchorOffsetY="10" y="414" horizontalCenter="-55" touchEnabled="false" name="jiantou"
            touchChildren="false" />
        <e:Label id="vip_privilege" text="VIP5特权" y="439.68" size="28" textAlign="center"
            strokeColor="0x000000"
            stroke="1" height="30" verticalAlign="middle" textColor="0xFFEF46" scaleX="1" scaleY="1"
            horizontalCenter="0" />
        <e:Image id="cur_line" source="shop_bar_png" scale9Grid="11,0,421,12" y="233" scaleX="1"
            scaleY="1" x="78" />
        <e:Label id="cur_expvip" text="3000/40000" y="229" size="22" textAlign="center"
            strokeColor="0x000000"
            stroke="1" textColor="0xF8F7D3" scaleX="1" scaleY="1" horizontalCenter="0" />
        <e:Group id="group_next" width="501" height="122" y="100" scaleX="1" scaleY="1"
            anchorOffsetX="0"
            anchorOffsetY="0" touchEnabled="false" horizontalCenter="0">
            <e:Label text="Nạp thêm" x="159.32" y="17" size="26" textAlign="left"
                strokeColor="0x000000" stroke="1"
                width="128" height="30" verticalAlign="middle" textColor="0xFFEF46" scaleX="1"
                scaleY="1" />
            <e:Label text="Nâng cấp" x="23" y="78" size="24" textAlign="left" strokeColor="0x000000"
                stroke="1" width="108"
                height="30" verticalAlign="middle" textColor="0xFFEF46" scaleX="1" scaleY="1" />
            <e:Image source="ui_vip_png" x="134" y="76" scaleX="1" scaleY="1" />
            <e:Image source="form_zibg_png" scale9Grid="5,5,30,30" x="285" y="15" width="160"
                height="30" scaleX="1"
                scaleY="1" />
            <e:Label id="lbl_remain" text="123456789" y="15" size="20" textAlign="left"
                strokeColor="0x000000"
                stroke="1" textColor="0xFFFFFF" height="29" verticalAlign="middle" scaleX="1"
                scaleY="1"
                horizontalCenter="111.82999999999998" x="311" />
            <e:BitmapLabel id="next_vip" x="238" y="68" scaleX="1" scaleY="1" font="vip_number_fnt"
                text="0" />
        </e:Group>
        <e:Scroller width="500" height="105" y="268" anchorOffsetX="0" horizontalCenter="0"
            anchorOffsetY="0" x="51"
            scaleX="1" scaleY="1">
            <e:List id="list_gift" itemRendererSkinName="ItemSkin">
                <e:layout>
                    <e:HorizontalLayout gap="15" paddingLeft="10" />
                </e:layout>
            </e:List>
        </e:Scroller>
        <e:Group id="btn_front" width="300" height="336" y="478" scaleX="1" scaleY="1"
            anchorOffsetX="0" anchorOffsetY="0" x="0">
            <e:Image source="left_png" y="148" scaleX="1" scaleY="1" touchEnabled="false" x="10" />
        </e:Group>
        <e:Group id="btn_next" width="300" height="336" y="478" scaleX="1" scaleY="1"
            anchorOffsetX="0" anchorOffsetY="0" right="0">
            <e:Image source="right_png" y="151" scaleX="1" scaleY="1" touchEnabled="false" x="266" />
        </e:Group>
        <e:Image id="btn_close1" x="530" y="805" source="btn_close_2_png" name="btn_close"
            anchorOffsetX="0" anchorOffsetY="0" scaleX="1" scaleY="1" />
    </e:Group>
    <component:EuiMap id="privilegeData">
        <e:Array>
            <e:Object name="AddPackage" />
            <e:Object name="EquipInstanceTimes" />
            <e:Object name="GemInstanceTimes" />
            <e:Object name="MeridianInstanceTimes" />
            <e:Object name="GuildChallengeBuyTimes" />
            <e:Object name="ArenalTimes" />
            <e:Object name="OfflineDungeonAdd" />
            <e:Object name="StealGold" />
            <e:Object name="OpenTreasureTimes" />
        </e:Array>
    </component:EuiMap>
</e:Skin>