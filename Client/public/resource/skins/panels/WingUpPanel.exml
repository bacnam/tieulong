<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="WingUpPanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui"
	xmlns:w="http://ns.egret.com/wing">
	<e:Group width="400" height="586" horizontalCenter="0" verticalCenter="36" anchorOffsetY="0">
		<e:Image source="smallui_bg_png" scale9Grid="74,32,53,47" width="400" height="584" x="0"
			scaleX="1" scaleY="1" anchorOffsetY="0" />
		<e:Image source="smallui_tbg_png" y="11" scaleX="1" scaleY="1" horizontalCenter="0" />
		<e:RadioButton id="btn_gold" label="" x="20" y="65" value="1">
			<e:skinName>
				<e:Skin states="up,down,disabled">
					<e:Image width="100%" height="100%" source="check_png" source.down="check_png" />
					<e:Image width="100%" height="100%" source="check_png" source.down="gou_png" />
					<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0" />
				</e:Skin>
			</e:skinName>
		</e:RadioButton>
		<e:RadioButton id="btn_wing" label="" x="20" y="190" value="2">
			<e:skinName>
				<e:Skin states="up,down,disabled">
					<e:Image width="100%" height="100%" source="check_png" source.down="check_png" />
					<e:Image width="100%" height="100%" source="check_png" source.down="gou_png" />
					<e:Label id="labelDisplay" horizontalCenter="0" verticalCenter="0" />
				</e:Skin>
			</e:skinName>
		</e:RadioButton>
		<e:CheckBox id="btn_crystal" x="53" y="268" selected="false" width="30" height="30">
			<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="check_png" source.down="check_png" />
				<e:Image width="100%" height="100%" source="check_png" source.down="gou_png" />
			</e:Skin>
		</e:CheckBox>
		<e:Label text="Nâng cấp nhanh" y="15" size="22" textAlign="center" strokeColor="0x5E3500"
			stroke="1" width="205" height="32" fontFamily="Arial" textColor="0xF7F397"
			verticalAlign="middle" scaleX="1" scaleY="1" horizontalCenter="0" />
		<e:Image source="btn_close_png" x="332" y="0" scaleX="1" scaleY="1" name="btn_close" />
		<e:Label text="Sử dụng vàng" y="68" size="28" textAlign="left" strokeColor="0x000000"
			stroke="1" textColor="0xF8F7D3" verticalAlign="top" x="65" />
		<e:Label text="Sử dụng toàn vàng để nâng cấp" y="110" size="20" textAlign="left"
			strokeColor="0x000000" stroke="1" width="314" verticalAlign="middle"
			textColor="0xFFFFFF" x="60" />
		<e:Image source="line_png" y="165" horizontalCenter="0" width="380" x="130" />
		<e:Label text="Chi phí: " y="410" size="22" textAlign="left" strokeColor="0x000000"
			stroke="1" textColor="0xF8F7D3" verticalAlign="top" x="73" />
		<e:Label id="tip" text="Chi phí: " y="445" size="22" textAlign="left" strokeColor="0x000000"
			stroke="1" verticalAlign="top" horizontalCenter="0" textColor="0xff0000" />
		<e:Label id="label_price" text="123456789012" y="410" size="22" textAlign="left"
			strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" verticalAlign="top" x="234" />
		<e:Label text="Sử dụng Lông vũ" y="195" size="28" textAlign="left" strokeColor="0x000000"
			stroke="1" textColor="0xF8F7D3" verticalAlign="top" x="76" />
		<e:Label text="Khi lông vũ không đủ, sẽ sử dụng Kim Nguyên Bảo." y="268" size="20"
			textAlign="left" strokeColor="0x000000" stroke="1" verticalAlign="top" x="95"
			textColor="0x00ff00" width="300"/>
		<e:Label text="Sử dụng lông vũ để nâng cấp." y="239" size="20" textAlign="left"
			strokeColor="0x000000" stroke="1" textColor="0xFFFFFF" width="314"
			verticalAlign="middle" horizontalCenter="22" />
		<e:Label text="Lưu ý: Chi phí trên chỉ là ước tính" y="529" size="14" textAlign="center"
			strokeColor="0x000000" stroke="1" width="354" verticalAlign="middle" height="44"
			textColor="0xA59FA0" horizontalCenter="0" />
		<e:Image source="money_bg_png" scale9Grid="37,2,125,36" y="355" width="380"
			horizontalCenter="0" />
		<e:Label id="label_cur" text="8阶翅膀8星" y="365" size="20" textAlign="center"
			strokeColor="0x5E3500" stroke="1" textColor="0xF7F397" verticalAlign="middle"
			horizontalCenter="-90" />
		<e:Label id="label_next" text="10阶翅膀8星" y="365" size="20" textAlign="center"
			strokeColor="0x5E3500" stroke="1" textColor="0xF7F397" verticalAlign="middle"
			horizontalCenter="90" />
		<e:Image source="right_png" y="357.5" width="20" height="35" horizontalCenter="10" />
		<e:Image id="price_icon" source="icon_gold_png" x="182" y="400.5" />
		<e:Image id="btn_up" source="btn_bg2_png" scale9Grid="56,4,23,37" y="480" scaleX="1"
			scaleY="1" horizontalCenter="0" />
		<e:Label id="label_up" text="Nâng cấp" y="493" size="22" textAlign="center"
			strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" horizontalCenter="0"
			touchEnabled="false" />
		<e:Label id="tip1" text="Đã đạt cấp tối đa" y="488" size="32" textAlign="left"
			strokeColor="0x000000" stroke="1" verticalAlign="top" horizontalCenter="0"
			textColor="0x00ff00" />
	</e:Group>
</e:Skin>