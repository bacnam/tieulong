<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="NoticePanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui"
	xmlns:w="http://ns.egret.com/wing">
	<e:Group width="591" height="847" horizontalCenter="0" verticalCenter="0" touchEnabled="false">
		<e:Group width="591" height="847" horizontalCenter="0" verticalCenter="0"
			touchEnabled="false" x="0" y="0" scaleX="1" scaleY="1">
			<e:Image source="ui_bg_png" scaleX="1" scaleY="1" touchEnabled="false" />
			<e:Image id="frombg" source="form_bg_png" width="550" height="743"
				scale9Grid="16,15,19,18" scaleX="1" scaleY="1" y="68.03" horizontalCenter="0"
				anchorOffsetY="0" />
			<e:Image id="btn_close" source="btn_close_png" y="11" scaleX="1" scaleY="1" x="517.33" />
			<e:Image id="tittle" y="6.01" scaleX="1" scaleY="1" horizontalCenter="0"
				source="notice_png" />
			<e:Scroller id="scroller" width="520" height="710" y="85" anchorOffsetX="0"
				anchorOffsetY="0" horizontalCenter="0">
				<e:Group id="group_content" anchorOffsetX="0" width="520" anchorOffsetY="0">
					<e:Group id="group_label" y="0" horizontalCenter="0" width="520">
						<e:Label id="label_title" text="标题" y="17" scaleX="1" scaleY="1"
							anchorOffsetX="0" width="510" anchorOffsetY="0" lineSpacing="5"
							size="42" horizontalCenter="0" textAlign="center" height="42"
							bold="true" stroke="1" x="5" />
						<e:Label id="label_content" text="内容" y="80" scaleX="1" scaleY="1"
							anchorOffsetX="0" width="510" anchorOffsetY="0" lineSpacing="5"
							size="32" x="6" textAlign="left" />
					</e:Group>


					<e:Image id="img_content" horizontalCenter="0" source="" />
				</e:Group>
			</e:Scroller>
		</e:Group>
	</e:Group>
</e:Skin>