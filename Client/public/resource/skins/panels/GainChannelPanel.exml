            <e:Image source="ui_+_png" x="262" y="85" scaleX="1" scaleY="1" touchEnabled="false" />
            <e:Image source="form_zibg_png" scale9Grid="5,5,30,30" y="78" width="100" horizontalCenter="0" x="149"
