            <e:BitmapLabel id="label_subSup" y="85" font="yuan_fnt" text="10" touchEnabled="false"
                           horizontalCenter="-136.5" x="40" scaleX="1" scaleY="1" />
            <e:TextInput id="input" y="83" horizontalCenter="0" restrict="0-9" text="1323" x="149" scaleX="1" scaleY="1">
                <e:skinName>
                    <e:Skin states="normal,disabled,normalWithPrompt,disabledWithPrompt">
                        <e:EditableText id="textDisplay" verticalCenter="0" textColor.disabled="0xffffff" width="100%"
                                        size="28" text="9999999" textColor="0xffffff" height="28" horizontalCenter="0"
                                        textAlign="center" />
                        <e:Label id="promptDisplay" verticalCenter="0" width="100%" size="28" touchEnabled="false"
                                 includeIn="normalWithPrompt,disabledWithPrompt" text="请输入" textColor="0xa6a7b6"
                                 height="28" horizontalCenter="0" textAlign="center" />
                    </e:Skin>
                </e:skinName>
            </e:TextInput>
            <e:Button id="btn_buy" label="Mua" y="170.66" width="130" scaleX="1" scaleY="1" horizontalCenter="0">
                <e:skinName>
                    <e:Skin states="up,down,disabled">
                        <e:Image width="100%" height="100%" source="btn_bg4_png" />
                        <e:Label id="labelDisplay" size="26" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3"
                                 horizontalCenter="0" verticalCenter="0" />
                    </e:Skin>
                </e:skinName>
            </e:Button>
        </e:Group>
			<e:Label id="tip2" text="Label" y="467" textColor="0x00ff00" size="22" horizontalCenter="0"/>
