        xmlns:component="legend.view.component.*" xmlns:w="http://ns.egret.com/wing">
    <e:Group id="group" width="400" height="495" verticalCenter="0" horizontalCenter="0" touchEnabled="false">
        <e:Image source="smallui_bg_png" scale9Grid="74,32,53,47" width="100%" height="100%" x="0.32" y="1" scaleX="1"
                 scaleY="1" />
        <e:Image source="tit_bg_png" scale9Grid="99,3,314,50" anchorOffsetX="0" width="100%" anchorOffsetY="0"
                 height="100%" />
        <e:Image source="tit_bg_png" scale9Grid="99,3,314,50" rotation="89.88" anchorOffsetY="0" height="100%"
                 anchorOffsetX="0" width="100%" x="400" />
        <e:Label id="itemName" text="Tên mục" x="115" y="60" size="30" textAlign="left" strokeColor="0x000000" stroke="1"
                 textColor="0xFDB200" verticalAlign="middle" scaleX="1" scaleY="1" anchorOffsetX="0" />
        <e:Scroller width="360" height="317" anchorOffsetX="0" anchorOffsetY="0" horizontalCenter="0" bottom="35">
            <e:List id="list">
                <e:itemRendererSkinName>
                    <e:Skin>
                        <e:Image source="form_jbg_png" scale9Grid="13,14,24,22" width="340" height="105" scaleX="1"
                                 scaleY="1" horizontalCenter="0" verticalCenter="0" />
                        <e:Label id="label_des" text="Cửa hàng" x="120" size="22" textAlign="left" strokeColor="0x000000"
                                 stroke="1" textColor="0xFDB200" width="125" verticalAlign="middle" scaleX="1"
                                 scaleY="1" verticalCenter="0" />
                        <e:Image id="icon" source="icon_shop_png" x="13.5" scaleX="1" scaleY="1" verticalCenter="0" />
                        <e:Button id="btn_go" label="Đi đến" x="240" anchorOffsetX="0" verticalCenter="0">
                            <e:skinName>
                                <e:Skin states="up,down,disabled">
                                    <e:Image width="100%" height="100%" source="btn_bg5_png" />
                                    <e:Label id="labelDisplay" size="22" textAlign="center" strokeColor="0x000000"
                                             stroke="1" textColor="0xF8F7D3" horizontalCenter="0" verticalCenter="0" />
                                </e:Skin>
                            </e:skinName>
                        </e:Button>
                    </e:Skin>
                </e:itemRendererSkinName>
                <e:layout>
                    <e:VerticalLayout gap="8" paddingRight="0" horizontalAlign="center" />
                </e:layout>
            </e:List>
        </e:Scroller>
        <component:BaseItem id="baseItem" width="72" height="72" x="32.81" y="53" />
        <e:Image source="smallui_tbg_png" y="6" scaleX="1" scaleY="1" x="54" />
        <e:Label text="Cửa hàng" y="10" size="24" textAlign="center" strokeColor="0x5E3500" stroke="1" width="205"
                 height="32" fontFamily="Arial" verticalAlign="middle" x="98" scaleX="1" scaleY="1" textColor="0xfdb200"
                 bold="true" />
        <e:Image source="btn_close_png" x="332.14" y="0.4" scaleX="1" scaleY="1" name="btn_close" />
        <e:Image source="line_png" scaleX="1" scaleY="2" anchorOffsetX="0" width="330" anchorOffsetY="0" height="1"
