<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="ShareInputPanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui"
        xmlns:w="http://ns.egret.com/wing">
    <e:Group width="400" height="245" anchorOffsetX="0" anchorOffsetY="0" verticalCenter="-125" horizontalCenter="0"
             touchEnabled="false">
        <e:Image source="smallui_bg_png" scale9Grid="74,32,53,47" width="400" height="245" scaleX="1" scaleY="1" />
        <e:Image source="smallui_tbg_png" y="9" scaleX="1" scaleY="1" anchorOffsetX="0" width="352" horizontalCenter="0"
                 touchEnabled="false" />
        <e:Image id="btn_confirm" source="btn_bg4_png" scale9Grid="5,5,110,34" x="222" y="177" width="100" scaleX="1"
                 scaleY="1" />
        <e:Label text="确认" x="250" y="188" size="22" textAlign="left" strokeColor="0x000000" stroke="1"
                 textColor="0xF8F7D3" touchEnabled="false" scaleX="1" scaleY="1" />
        <e:Image id="btn_cancel" source="btn_bg4_png" scale9Grid="5,5,110,34" x="82" y="177" width="100"
                 name="btn_close" scaleX="1" scaleY="1" />
        <e:Label text="取消" x="110" y="188" size="22" textAlign="left" strokeColor="0x000000" stroke="1"
                 textColor="0xF8F7D3" touchEnabled="false" scaleX="1" scaleY="1" />
        <e:Image source="btn_close_png" x="333" y="1" name="btn_close" scaleX="1" scaleY="1" />
        <e:Label id="tittle" text="分享" y="13" size="22" textAlign="center" strokeColor="0x5E3500" stroke="1"
                 height="32" fontFamily="Arial" textColor="0xF7F397" verticalAlign="middle" scaleX="1" scaleY="1"
                 horizontalCenter="0" />
			<e:Label text="请输入分享的内容（选填）" y="54" size="22" textAlign="center" strokeColor="0x5E3500" stroke="1" fontFamily="Arial" verticalAlign="middle" scaleX="1" scaleY="1" horizontalCenter="0" textColor="0x00ff00"/>
        <e:Image source="zi_bg_png" scale9Grid="7,7,36,36" scaleX="1" scaleY="1" height="60" anchorOffsetX="0"
                 width="370" anchorOffsetY="0" verticalCenter="0.5" horizontalCenter="0" />
        <e:TextInput id="input" width="343" height="40" anchorOffsetX="0" anchorOffsetY="0" horizontalCenter="0.5"
                     verticalCenter="0.5" skinName="skins.TextInputSkin"></e:TextInput>
    </e:Group>
</e:Skin>