<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="EquipPanel" xmlns:e="http://ns.egret.com/eui" width="640" height="1136"
        xmlns:w="http://ns.egret.com/wing" xmlns:component="legend.view.component.*">
	<w:Config id="1583409832b" width="100%" height="100%" />
	<e:Group id="group"  horizontalCenter="0.5" verticalCenter="0" height="500">
		<e:Image source="smallui_bg_png" scale9Grid="50,50,50,20" height="100%" verticalCenter="0" scaleX="1" scaleY="1"
		         width="490" horizontalCenter="0" />
		<e:Label id="label_name" text="战甲名称" size="22" textAlign="left" strokeColor="0x000000" stroke="1" textColor="0xFDB200"
		         width="260" height="30" verticalAlign="middle" scaleX="1" scaleY="1" top="44.22" horizontalCenter="49" />
		<e:Label text="Cấp:" size="22" textAlign="left" strokeColor="0x000000" stroke="1" height="30"
		         verticalAlign="middle" textColor="0xFEFEFE" scaleX="1" scaleY="1" top="83"
		          left="164"/>
		<e:Label id="label_level" text="10级" size="22" textAlign="left" strokeColor="0x000000" stroke="1" height="30" verticalAlign="middle" scaleX="1" scaleY="1" top="83" left="220" textColor="0x00ff00"/>
		<e:Label text="Lực chiến:" size="22" textAlign="left" strokeColor="0x000000" stroke="1" textColor="0xFEFEFE" height="30"
		         verticalAlign="middle" scaleX="1" scaleY="1" horizontalCenter="-137" top="135.43" />
		<e:Label id="label_power" text="1234567890" size="22" textAlign="left" strokeColor="0x000000" stroke="1" textColor="0xFEFEFE"
		         height="30" verticalAlign="middle" scaleX="1" scaleY="1" top="136.05"  x="165"/>
		<e:Label id="label_description" text="这是装备的说明文。形成盾，盾可抵消伤害，免疫定身形成盾，盾可抵消伤害，免疫定身形成盾，盾可抵消伤害，免疫定身" size="22"
		         textAlign="left" strokeColor="0x000000" stroke="1" textColor="0xFEFEFE" width="353" height="93"
		         verticalAlign="top" scaleX="1" scaleY="1" x="65" bottom="138.32999999999998" />
		<e:Image source="line_png" horizontalCenter="0" width="400" x="87" scaleX="1" scaleY="1" top="126.09" />
		<e:Image source="line_png" horizontalCenter="0" width="400" x="87" scaleX="1" scaleY="1" top="174.7" />
		<e:Image source="line_png" horizontalCenter="0" width="400" x="87" scaleX="1" scaleY="1" bottom="116.97000000000003" />
		<e:Image source="line_png" horizontalCenter="0" width="400" x="87" scaleX="1" scaleY="1" bottom="250.31" />


		<e:Label id="label_lvExplain" text="Yêu cầu cấp độ:" size="20" textAlign="right" strokeColor="0x000000" stroke="1" scaleX="1" scaleY="1" height="26"
		         verticalAlign="middle" textColor="0x54FF00" horizontalCenter="0" x="0" bottom="78.74000000000001" />
		<e:Label id="label_lv" text="60" size="20" textAlign="left" strokeColor="0x000000" stroke="1" scaleX="1" scaleY="1"
		         height="26" verticalAlign="middle" textColor="0x54FF00" x="320.67" bottom="79.54999999999995" />

		<e:Image source="btn_close_png" scaleX="1" scaleY="1" name="btn_close" y="1.76" x="419.01" />
		<e:List id="list_attribute" width="360" x="68" anchorOffsetX="0" anchorOffsetY="0"
		        verticalCenter="-38">
			<e:itemRendererSkinName>
				<e:Skin>
					<e:Label id="attr" size="20" textAlign="left" strokeColor="0x000000" stroke="1" 
					         height="32" verticalAlign="middle"  textColor="0x4AECFF" />
				</e:Skin>
			</e:itemRendererSkinName>
			<e:layout>
				<e:VerticalLayout horizontalAlign="left" verticalAlign="middle"/>
			</e:layout>
		</e:List>
		<component:BaseItem id="baseItem" top="45" horizontalCenter="-145"/>
		<e:Label id="label_Type" text="Cổ mộ" y="51" anchorOffsetX="0" size="20" width="20" bold="true" textColor="0xECB70A" height="20" x="69.21000000000001" scaleX="1" scaleY="1"/>
		<e:Button id="btn_change" label="Mặc" horizontalCenter="0" bottom="20">
			<e:skinName>
				<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="btn_bg2_png"/>
				<e:Label id="labelDisplay" size="22" textAlign="center" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" horizontalCenter="0" verticalCenter="0"/>
				</e:Skin>
			</e:skinName>
		</e:Button>
		<e:Button id="btn_left" label="Mặc (trái)" horizontalCenter="-140" bottom="20">
			<e:skinName>
			<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="btn_bg2_png"/>
				<e:Label id="labelDisplay" size="22" textAlign="center" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
			</e:skinName>
		</e:Button>
		<e:Button id="btn_right" label="Mặc (phải)" horizontalCenter="140" bottom="20">
			<e:skinName>
			<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="btn_bg2_png"/>
				<e:Label id="labelDisplay" size="22" textAlign="center" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" horizontalCenter="0" verticalCenter="0"/>
			</e:Skin>
			</e:skinName>
		</e:Button>
	</e:Group>
</e:Skin>