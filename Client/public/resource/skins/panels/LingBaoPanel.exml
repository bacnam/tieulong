			<e:Image source="star_off_png" scaleX="1" scaleY="1" x="50" y="50"/>
			<e:Image source="star_off_png" scaleX="1" scaleY="1" x="60" y="60"/>
			<e:Image source="star_off_png" scaleX="1" scaleY="1" x="70" y="70"/>
			<e:Image source="star_off_png" scaleX="1" scaleY="1" x="80" y="80"/>
			<e:Image source="star_off_png" scaleX="1" scaleY="1" x="90" y="90"/>
			<e:layout>
				<e:HorizontalLayout/>
			</e:layout>
		</e:Group>
		<e:Group x="74" y="401">
			<e:Image source="smallui_tbg_png" y="0" anchorOffsetX="0" width="192" anchorOffsetY="0" height="60.5"  horizontalCenter="0"/>

			<e:Image source="form_sibg_png" scale9Grid="17,16,16,17" x="1" y="65" anchorOffsetX="0" width="190" anchorOffsetY="0"
			         height="135" />
			<e:Label text="Hiện tại: " y="22" size="22" textAlign="left" strokeColor="0x000000" stroke="1" textColor="0xFFFEFD"
			         anchorOffsetX="0" anchorOffsetY="0" bold="true"  x="66"/>
			<e:Scroller height="120" y="73" anchorOffsetX="0" anchorOffsetY="0" x="12">
				<e:List id="list_cur">
					<e:itemRendererSkinName>
						<e:Skin>
							<e:Label text="{data}" size="16" textAlign="left" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3"
							         width="197" height="19" />
						</e:Skin>
					</e:itemRendererSkinName>
					<e:layout>
						<e:VerticalLayout horizontalAlign="left" verticalAlign="middle" />
					</e:layout>
				</e:List>
			</e:Scroller>
		</e:Group>
		<e:Group x="334" y="401">
			<e:Image source="smallui_tbg_png" y="0" anchorOffsetX="0" width="192" anchorOffsetY="0" height="60.5" x="0" />

			<e:Image source="form_sibg_png" scale9Grid="17,16,16,17" x="1" y="65" anchorOffsetX="0" width="190" anchorOffsetY="0"
			         height="135" />
			<e:Label text="Cấp sau:" x="56" y="22" size="22" textAlign="left" strokeColor="0x000000" stroke="1" textColor="0xFFFEFD"
			         anchorOffsetX="0" anchorOffsetY="0" bold="true" />
			<e:Scroller height="120" anchorOffsetX="0" anchorOffsetY="0" scaleX="1" scaleY="1" y="73"
			            x="12">
				<e:List id="list_next">
					<e:itemRendererSkinName>
						<e:Skin>
							<e:Label text="{data}" size="16" textAlign="left" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3"
							         width="197" height="19" />
						</e:Skin>
					</e:itemRendererSkinName>
					<e:layout>
						<e:VerticalLayout horizontalAlign="left" verticalAlign="middle" />
