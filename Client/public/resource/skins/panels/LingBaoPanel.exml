		<component:Power id="power" y="86" skinName="Power" horizontalCenter="12.5" />
		<e:Image id="btn_close" name="btn_close" source="btn_close_png" y="13" scaleX="1" scaleY="1" x="516.33" />
		<e:Image id="tittle" y="5.01" scaleX="1" scaleY="1" horizontalCenter="0" source="lingbao_png" />
		<e:Image id="btn_help" source="ui_heip_png" x="51" y="129.5" />
		<e:Button id="btn_up" label="Nâng cấp" y="738" horizontalCenter="0">
			<e:skinName>
				<e:Skin states="up,down,disabled">
					<e:Image width="100%" height="100%" source="btn_bg2_png" />
					<e:Label id="labelDisplay" size="24" horizontalCenter="0" verticalCenter="0" strokeColor="0x000000" stroke="1"
