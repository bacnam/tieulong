<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="LingBaoPanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui"
        xmlns:component="legend.view.component.*" xmlns:w="http://ns.egret.com/wing">
	<e:Group width="591" height="847" horizontalCenter="0" verticalCenter="0">
		<e:Image source="ui_bg_png" scaleX="1" scaleY="1" horizontalCenter="0" verticalCenter="0" />
		<e:Image source="form_bg_png" scale9Grid="16,15,19,18" y="63" anchorOffsetX="0" width="552" anchorOffsetY="0"
		         height="748.94" scaleX="1" scaleY="1" horizontalCenter="0.5" />
		<e:Image source="list_bg_jpg" y="74.00000000000003" anchorOffsetX="0" width="531" anchorOffsetY="0" height="725"
		         scaleX="1" scaleY="1" horizontalCenter="0" />
		<e:Component id="icon_bg" width="20" height="20" x="280" y="329" touchEnabled="false" touchChildren="false"/>
		<e:CheckBox id="btn_auto" width="31" height="31" x="42" y="757" selected="false">
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="check_png" source.down="check_png"/>
			<e:Image width="100%" height="100%" source="check_png" source.down="gou_png"/>
			</e:Skin>
		</e:CheckBox>
		<e:Label text="Tự động nâng cấp" size="20" textAlign="left" strokeColor="0x000000" stroke="1" height="30" verticalAlign="middle" scaleX="1" scaleY="1" x="82" y="757" textColor="0x00FF00"/>
		<e:Image source="form_goldtit_png" y="169.02" scaleX="1" scaleY="1" horizontalCenter="0.5" x="159"/>
		<e:Label id="label_level" text="黄金羽翼 10级" y="174" size="22" textAlign="center" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" horizontalCenter="0"/>
		<e:Image source="namebg_png" x="490.92" y="179.85" rotation="90.13"/>
		<e:Label id="label_name" text="游方行者" x="452" y="215" size="24" textAlign="left" strokeColor="0x000000" stroke="1" width="28" textColor="0xFFFEFD" anchorOffsetX="0" anchorOffsetY="0" bold="true"/>

		<e:Label id="material1" text="385 / 1" x="420" y="695" size="20" textAlign="center" strokeColor="0x000000"
		         stroke="1" anchorOffsetX="0" textColor="0x00FF00" />
		<e:Group id="group_star" y="611" anchorOffsetY="0" horizontalCenter="0.5">
			<e:Image source="star_off_png" scaleX="1" scaleY="1"/>
			<e:Image source="star_off_png" scaleX="1" scaleY="1" x="10" y="10"/>
			<e:Image source="star_off_png" scaleX="1" scaleY="1" x="20" y="20"/>
