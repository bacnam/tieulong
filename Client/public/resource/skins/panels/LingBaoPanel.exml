				</e:Skin>
			</e:skinName>
		</e:Button>
		<e:Button id="btn_upstage" label="Tăng cấp" y="738" horizontalCenter="0">
			<e:skinName>
			<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="btn_bg1_png"/>
				<e:Label id="labelDisplay" size="24" horizontalCenter="0" verticalCenter="0" strokeColor="0x000000" stroke="1" bold="true" textColor="0xFFFBD8"/>
			</e:Skin>
			</e:skinName>
		</e:Button>
	</e:Group>
</e:Skin>