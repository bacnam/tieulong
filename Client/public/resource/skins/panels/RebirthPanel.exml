<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="RebirthPanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui"
	xmlns:component="legend.view.component.*" xmlns:w="http://ns.egret.com/wing">
	<e:Group width="591" height="847" horizontalCenter="0" verticalCenter="0" touchEnabled="false">
		<e:Group width="591" height="847" horizontalCenter="0" verticalCenter="0" x="0" y="0"
			scaleX="1" scaleY="1"
			touchEnabled="false">
		</e:Group>
		<e:Image source="ui_bg_png" horizontalCenter="0.5" verticalCenter="0.5" x="0" y="0"
			scaleX="1" scaleY="1" />
		<e:Image id="btn_close" name="btn_close" source="btn_close_png" y="13" scaleX="1" scaleY="1"
			x="517.33" />
		<e:Image source="form_bg_png" scale9Grid="16,15,19,18" x="19.5" y="63.66999999999999"
			anchorOffsetX="0" width="552"
			anchorOffsetY="0" height="741.67" scaleX="1" scaleY="1" />
		<e:Image source="list_bg_jpg" x="30.14" y="74" anchorOffsetX="0" width="531.5"
			anchorOffsetY="0" height="716"
			scaleX="1" scaleY="1" />
		<e:Image source="smallui_tbg_png" y="266.33" anchorOffsetX="0" width="192" anchorOffsetY="0"
			height="60.5"
			horizontalCenter="-122.67000000000002" x="76" scaleX="1" scaleY="1" />
		<e:Image source="form_sibg_png" scale9Grid="17,16,16,17" y="327.33" anchorOffsetX="0"
			width="190" anchorOffsetY="0"
			height="259" horizontalCenter="-122.5" x="77" scaleX="1" scaleY="1" />
		<e:Label text="Cấp hiện tại" y="270" size="22" textAlign="left" strokeColor="0x000000"
			stroke="1"
			anchorOffsetX="0" anchorOffsetY="0" height="24" bold="true" horizontalCenter="-115"
			x="146" scaleX="1"
			scaleY="1" textColor="0xfdb200" />
		<e:Label id="label_curlv" text="Lv.73" y="300" size="20" textAlign="left"
			strokeColor="0x000000" stroke="1"
			textColor="0xFFFEFD" anchorOffsetX="0" anchorOffsetY="0" height="27"
			horizontalCenter="-120" x="147"
			scaleX="1" scaleY="1" />
		<e:Image source="smallui_tbg_png" y="266.33" anchorOffsetX="0" width="192" anchorOffsetY="0"
			height="60.5"
			horizontalCenter="125" x="324" scaleX="1" scaleY="1" />
		<e:Image source="form_sibg_png" scale9Grid="17,16,16,17" y="327.33" anchorOffsetX="0"
			width="190" anchorOffsetY="0"
			height="259" horizontalCenter="125.5" x="325" scaleX="1" scaleY="1" />
		<e:Label text="Cấp tiếp theo" y="271.33" size="22" textAlign="left" strokeColor="0x000000"
			stroke="1"
			anchorOffsetX="0" anchorOffsetY="0" height="24" bold="true" x="354" scaleX="1"
			scaleY="1" textColor="0xfdb200" />
		<e:Label id="label_nextlv" text="Lv.73" y="300" size="20" textAlign="left"
			strokeColor="0x000000" stroke="1"
			textColor="0xFFFEFD" anchorOffsetX="0" anchorOffsetY="0" height="27"
			scaleX="1" scaleY="1" horizontalCenter="125" />
		<e:Label text="Tự động chuyển sinh" x="102" y="750" size="20" textAlign="left"
			strokeColor="0x000000" stroke="1" width="193"
			anchorOffsetX="0" textColor="0x00FF00" scaleX="1" scaleY="1" />
		<e:Label text="Phí:" y="597" size="22" textAlign="left" strokeColor="0x5E3500" stroke="1"
			width="160" height="32"
			verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0" x="220"
			scaleX="1" scaleY="1" textColor="0xffc446" />
		<e:CheckBox id="btn_auto" width="31" height="31" x="58" y="744" selected="false">
			<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="check_png" source.down="check_png" />
				<e:Image width="100%" height="100%" source="check_png" source.down="gou_png" />
			</e:Skin>
		</e:CheckBox>
		<e:Image source="loading_bg_png" scale9Grid="57,0,409,39" y="629" anchorOffsetX="0"
			scaleX="1"
			scaleY="1" horizontalCenter="0" />
		<e:Image id="line_exp" source="loading_line_jpg" y="646.02" scaleX="1" left="85" />
		<e:Label id="label_exp" text="108/3" x="377" y="600" size="22" textAlign="left"
			strokeColor="0x000000" stroke="1"
			height="30" verticalAlign="middle" textColor="0xFF0000" bold="true" scaleX="1"
			scaleY="1" />
		<e:Image source="title_zhuansheng_png" y="6.6699999999999875" horizontalCenter="0" x="261"
			scaleX="1" scaleY="1" />
		<component:RoleSubPanel id="roleSubPanel" y="49.66999999999999" horizontalCenter="0" x="20"
			scaleX="1" scaleY="1" touchEnabled="false" />
		<component:Power id="power" y="175" scaleX="1" scaleY="1" skinName="Power"
			horizontalCenter="0" />
		<e:Label id="label_expcur" text="3000/40000" y="641" size="22" textAlign="center"
			strokeColor="0x000000" stroke="1" horizontalCenter="0" textColor="0xffffff" />
		<e:Button id="btn_up" label="Chuyển sinh" y="700" scaleX="1" scaleY="1" horizontalCenter="0">
			<e:skinName>
				<e:Skin states="up,down,disabled">
					<e:Image width="100%" height="100%" source="btn_bg2_png" />
					<e:Label id="labelDisplay" size="22" horizontalCenter="0" verticalCenter="0"
						strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" />
				</e:Skin>
			</e:skinName>
		</e:Button>
		<e:Button id="btn_rebirth" label="Chuyển Sinh" y="700" scaleX="1" scaleY="1"
			horizontalCenter="0">
			<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="btn_bg1_png" />
				<e:Label id="labelDisplay" size="22" horizontalCenter="0" verticalCenter="0"
					strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" />
			</e:Skin>
		</e:Button>
		<e:Label id="tip" text="标签" y="693" scaleX="1" scaleY="1" textColor="0xff0000" bold="true"
			stroke="1" touchEnabled="false" horizontalCenter="0" size="20" />
		<e:Scroller height="230" x="93" y="340" scaleX="1" scaleY="1" anchorOffsetX="0"
			anchorOffsetY="0">
			<e:List id="list_cur" y="340" anchorOffsetX="0" anchorOffsetY="0"
				horizontalCenter="-120" x="95" scaleX="1" scaleY="1" height="230">
				<e:itemRendererSkinName>
					<e:Skin>
						<e:Label text="{data}" size="20" strokeColor="0x000000" stroke="1"
							verticalAlign="middle"
							textColor="0xFAF9FB" anchorOffsetX="0" anchorOffsetY="0" />
					</e:Skin>
				</e:itemRendererSkinName>
				<e:layout>
					<e:VerticalLayout gap="10" />
				</e:layout>
			</e:List>
		</e:Scroller>
		<e:Scroller height="230" x="343" y="340" scaleX="1" scaleY="1" anchorOffsetX="0"
			anchorOffsetY="0">
			<e:List id="list_next" y="338" anchorOffsetX="0" anchorOffsetY="0" x="344" scaleX="1"
				scaleY="1">
				<e:itemRendererSkinName>
					<e:Skin>
						<e:Label text="{data}" size="20" strokeColor="0x000000" stroke="1"
							verticalAlign="middle"
							textColor="0x00FF00" anchorOffsetX="0" anchorOffsetY="0" />
					</e:Skin>
				</e:itemRendererSkinName>
				<e:layout>
					<e:VerticalLayout gap="10" />
				</e:layout>
			</e:List>
		</e:Scroller>
		<e:Image id="btn_close1" x="535" y="800" source="btn_close_2_png" name="btn_close"
			anchorOffsetX="0" anchorOffsetY="0" />

	</e:Group>
</e:Skin>