<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="DressPanel" width="640" height="1136" xmlns:e="http://ns.egret.com/eui"
        xmlns:component="legend.view.component.*" xmlns:panels="legend.panels.*">
	<e:Group width="591" height="847" horizontalCenter="0" verticalCenter="0">
		<e:Image source="ui_bg_png" scaleX="1" scaleY="1" touchEnabled="false" />
		<e:Image id="frombg" source="form_bg_png" width="550" height="696" scale9Grid="16,15,19,18" scaleX="1" scaleY="1"
		         y="67.03" horizontalCenter="0" />
		<e:Image id="btn_close" name="btn_close" source="btn_close_png" y="13" scaleX="1" scaleY="1" x="516.33" />
		<e:Image id="tittle" y="5.01" scaleX="1" scaleY="1" horizontalCenter="0" source="xiake_png" />
		<e:TabBar id="tabBar_page" y="760" scaleX="1" scaleY="1" itemRendererSkinName="Button_funcSkin" selectedIndex="0"
		          x="55">
			<e:itemRendererSkinName>
				<e:Skin states="up,down,disabled">
					<e:Image source="tab_off_png" source.down="tab_on_png" scale9Grid="11,0,102,35" y="0" horizontalCenter="0" />
					<e:Label y="12" anchorOffsetX="0.5" anchorOffsetY="0.5" horizontalCenter="0" text="{data.name}" size="20"/>
					<e:Image id="prompt" source="ui_red_png" top="0" right="0" width="25" visible="false"/>
				</e:Skin>
			</e:itemRendererSkinName>
			<e:ArrayCollection>
				<e:Array>
					<e:Object name="Phái" type='Role' />
					<e:Object name="Cánh" type='Wing' />
				</e:Array>
			</e:ArrayCollection>
		</e:TabBar>
		<e:Image source="list_bg_jpg" y="77.02" anchorOffsetX="0" anchorOffsetY="0" width="530" height="675"
		         horizontalCenter="0.5" />


		<e:Image id="wingicon" source="bigwing_3_png" horizontalCenter="0" verticalCenter="0" />
		<e:Image id="roleicon" source="biggumu3_png" horizontalCenter="0" verticalCenter="0" x="10" y="10" />
		<e:Image source="tit_bg_png" scale9Grid="99,3,314,50" y="595" anchorOffsetY="0" height="147.5" anchorOffsetX="0"
		         width="521" horizontalCenter="0" />
		<e:Image source="form_sibg_png" scale9Grid="17,16,16,17" y="598" anchorOffsetX="0" width="521.83" anchorOffsetY="0"
		         height="142.17"  x="35"/>
		<e:Group id="group_attr" x="38" y="389" anchorOffsetX="0" width="170">
			<e:Image source="smallui_bg_png" scale9Grid="74,32,53,47" y="0" anchorOffsetX="0" width="170" anchorOffsetY="0"
			         height="184"  alpha="0.5"/>
			<e:Label id="label_name" text="Dark Phantom" y="8" size="22" textAlign="left" strokeColor="0x5E3500" stroke="1" height="32"
			         verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0"  horizontalCenter="0" textColor="0xfdb200"/>
			<e:Image source="line_png" y="43" width="140"  horizontalCenter="0"/>
			<e:Scroller height="126" y="51" anchorOffsetX="0" anchorOffsetY="0" scaleX="1" scaleY="1"
			            horizontalCenter="0">
				<e:List id="list" anchorOffsetY="0" x="0" y="3">
					<e:itemRendererSkinName>
						<e:Skin xmlns:w="http://ns.egret.com/wing">
							<e:Label text="{data}" size="20" textAlign="left" strokeColor="0x000000" stroke="1" verticalAlign="middle"
							         textColor="0xFFFFFF" />
						</e:Skin>
					</e:itemRendererSkinName>
					<e:layout>
						<e:VerticalLayout gap="7"/>
					</e:layout>
				</e:List>
			</e:Scroller>
		</e:Group>
		<e:Image source="smallui_tbg_png" y="557.16" horizontalCenter="0.5" />
		<e:Label text="Thời trang" y="567.16" size="22" textAlign="left" strokeColor="0x5E3500" stroke="1" width="98.17"
		         anchorOffsetX="0" anchorOffsetY="0" height="21" horizontalCenter="4.5"  textColor="0xfdb200" bold="true"/>
		<e:Group id="group_need" x="408.5" y="448">
			<e:Image id="needbg" source="ui_tit_bg_png" x="0" y="0" anchorOffsetY="0" height="125" anchorOffsetX="0" width="172.67" />
			<e:Label id="needtip" text="Nhu cầu:" x="10.330000000000041" y="13.5" size="20" textAlign="left" strokeColor="0x5E3500" stroke="1"
			         width="72.18" anchorOffsetX="0" anchorOffsetY="0" height="21"  textColor="0xffc446"/>
			<e:Label id="label_need" text="Dark Phantom X1" y="49" size="20" textAlign="left" strokeColor="0x000000" stroke="1"
			         verticalAlign="middle" fontFamily="Arial" x="19" anchorOffsetX="0" anchorOffsetY="0" textColor="0xFFFFFF" />
			<e:Button id="btn" label="Kích hoạt" x="39.16" y="82.3">
				<e:skinName>
					<e:Skin states="up,down,disabled">
						<e:Image width="100%" height="100%" source="btn_bg5_png" />
						<e:Label id="labelDisplay" size="22" textAlign="center" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3"
						         horizontalCenter="0" verticalCenter="0" />
					</e:Skin>
				</e:skinName>
			</e:Button>
		</e:Group>
		<e:Scroller width="450" height="130" y="605" anchorOffsetX="0" anchorOffsetY="0" horizontalCenter="0.5">
			<e:List id="dresslist" itemRendererSkinName="DressItem">
				<e:layout>
					<e:HorizontalLayout gap="0" />
				</e:layout>
			</e:List>
		</e:Scroller>
		<e:Group id="btn_front" width="67" height="130" y="604" anchorOffsetX="0" anchorOffsetY="0">
			<e:Image source="left_png" scaleX="1" scaleY="1" verticalCenter="0" right="0" />
		</e:Group>
		<e:Group id="btn_next" width="65" height="130" y="604" anchorOffsetX="0" anchorOffsetY="0" x="526">
			<e:Image source="left_png" scaleX="-1" scaleY="1" verticalCenter="0" left="0" />
		</e:Group>
		<component:RoleSubPanel id="roleSubPanel" scaleX="1" scaleY="1" horizontalCenter="0" skinName="RoleSubPanelSkin" verticalCenter="-289" x="20" y="60"/>
		<component:Power id="component_power" skinName="Power" horizontalCenter="0" verticalCenter="-213.5" x="128" y="175" scaleX="1" scaleY="1"/>
		<e:Image id="btn_close1" x="535" y="800" source="btn_close_2_png" name="btn_close" anchorOffsetX="0" anchorOffsetY="0"/>

	</e:Group>
</e:Skin>