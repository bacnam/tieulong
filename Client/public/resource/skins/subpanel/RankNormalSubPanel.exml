				<e:Label id="label_oneName" text="s1." x="140" y="95" size="22" textAlign="left"
					strokeColor="0x000000" stroke="1" textColor="0xFFFFFF" height="29"
					verticalAlign="middle" touchEnabled="false" scaleX="1" scaleY="1" />
				<e:Image id="img_love" source="love_png" width="40" height="40" y="90" x="91"
					scaleX="1" scaleY="1" />
			</e:Group>
			<e:Image id="title" y="-51" source="shidagaoshou_png" horizontalCenter="0" />
		</e:Group>
		<e:Scroller width="415" height="232" x="1" y="381" anchorOffsetY="0" scaleX="1" scaleY="1">
			<e:List id="list_rankList" width="100%" itemRendererSkinName="RankItem" />
		</e:Scroller>
	</e:Group>
	<e:Group id="group_role" width="560" height="128" touchEnabled="false" scaleX="1" scaleY="1"
