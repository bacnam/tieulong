			<e:Image id="roleIcon" scaleX="1" scaleY="1" anchorOffsetX="256" anchorOffsetY="256"
				source="biggumu1_png" touchEnabled="false" horizontalCenter="6.5"
				verticalCenter="12.5" />
			<e:BitmapLabel id="label_oneVip" x="62.67" y="329.33" font="vip_number_fnt" text="0"
