			<e:Label id="guild_master" text="Bang chủ" x="278" y="71" size="24" textAlign="left"
				strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" anchorOffsetX="0" scaleX="1"
				scaleY="1" />
		</e:Group>
	</e:Group>
</e:Skin>