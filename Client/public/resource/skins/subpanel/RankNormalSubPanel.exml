			<e:Image source="ui_rank_bg_png" x="21" y="258" scaleX="1" scaleY="1"
				touchEnabled="false" />
			<e:Image id="onevip_bg" source="ui_vip_bg_png" x="-4" y="329" scaleX="1" scaleY="1"
				touchEnabled="false" />
			<e:Image id="img_vipIcon" source="ui_vip_png" x="19" y="332" width="51" height="19"
				scaleX="1" scaleY="1" touchEnabled="false" />
			<e:Label text="1" y="275.01" size="26" textAlign="left" strokeColor="0x8B1725"
				stroke="2" textColor="0xFCE795" scaleX="1" scaleY="1" x="43" touchEnabled="false" />
			<e:Image id="wingIcon" scaleX="1" scaleY="1" anchorOffsetX="256" anchorOffsetY="256"
				source="bigwing_1_png" touchEnabled="false" horizontalCenter="-0.5"
