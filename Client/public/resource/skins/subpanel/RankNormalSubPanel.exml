<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="RankNormalSubPanel" width="560" height="780" xmlns:e="http://ns.egret.com/eui">
	<e:Group id="group_normal" width="420" height="615" x="130" y="15" anchorOffsetX="0"
		anchorOffsetY="0">
		<e:Group id="group_first" width="415" height="375" x="1" y="0" touchEnabled="false"
			anchorOffsetX="0" scaleX="1" scaleY="1">
			<e:Image id="firstinfo" source="form_jbg_png" scale9Grid="13,14,24,22" x="0" y="0"
