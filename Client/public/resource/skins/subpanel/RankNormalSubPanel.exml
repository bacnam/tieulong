					touchEnabled="false" textColor="0xffffff" />
				<e:Label text="Bang:" y="-20" size="24" textAlign="left" strokeColor="0x000000"
					stroke="1" verticalAlign="middle" anchorOffsetX="0" scaleX="1" scaleY="1"
					touchEnabled="false" textColor="0xffffff" />
				<e:Label id="label_masterName" text="帮主" y="15" size="22" textAlign="left"
					strokeColor="0x000000" stroke="1" verticalAlign="middle" x="65"
					anchorOffsetX="0" scaleX="1" scaleY="1" touchEnabled="false"
					textColor="0xffffff" />
				<e:Label id="label_guildName" text="s177.哈哈哈哈哈哈哈 11转" y="-20" size="22"
					textAlign="left" strokeColor="0x000000" stroke="1" verticalAlign="middle"
					anchorOffsetX="0" scaleX="1" scaleY="1" touchEnabled="false" x="65"
					textColor="0xffffff" />
			</e:Group>
			<e:Group id="firstrole" width="100%" height="200" y="170" anchorOffsetX="0" x="0"
