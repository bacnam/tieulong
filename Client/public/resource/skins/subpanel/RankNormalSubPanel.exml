			<e:Label text="Hạng của bạn:" x="160" y="26" size="24" textAlign="left"
				strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" anchorOffsetX="0"
				anchorOffsetY="0" height="26" scaleX="1" scaleY="1" />
			<e:Label id="guild_rank" text="100000" y="26" size="24" textAlign="left"
