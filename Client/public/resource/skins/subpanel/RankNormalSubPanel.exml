			<e:Image source="cap_bg_png" y="304" x="124" scaleX="1" scaleY="1" width="275"
				height="57" touchEnabled="false" />
			<e:BitmapLabel id="label_onePower" x="219" y="323" font="power_number3_fnt" text="0"
				scaleX="0.8" scaleY="0.8" touchEnabled="false" />
			<e:Group id="firstguild" width="310" height="102" x="101" y="266" anchorOffsetX="0"
				anchorOffsetY="0" touchEnabled="false" visible="false">
				<e:Label text="Bang chủ:" y="15" size="22" textAlign="left" strokeColor="0x000000"
