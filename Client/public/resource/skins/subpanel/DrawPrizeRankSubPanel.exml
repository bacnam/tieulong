<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="DrawPrizeRankSubPanel" width="520" height="640" xmlns:e="http://ns.egret.com/eui"
        xmlns:w="http://ns.egret.com/wing">
	<e:Image source="huodong_bg_jpg" horizontalCenter="0" />
	<e:Group y="18" horizontalCenter="0">
		<e:Image source="form_hd_png" scale9Grid="40,34,20,32" x="0" y="0" anchorOffsetX="0" width="494" anchorOffsetY="0"
		         height="304.67" />
		<e:Image source="vip_line_png" x="5" y="65" width="480" />
		<e:Label text="排行奖励" y="17.33" size="34" textAlign="left" strokeColor="0x5E3500" stroke="1" height="32"
		         verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0" textColor="0xFFF135" horizontalCenter="0" />
		<e:Scroller width="461" height="212" y="74" anchorOffsetX="0" anchorOffsetY="0" horizontalCenter="0">
			<e:List id="reward_list">
				<e:itemRendererSkinName>
					<e:Skin>
						<e:Image source="form_goldtit_png" scale9Grid="84,3,65,27" anchorOffsetX="0" anchorOffsetY="0" height="32" x="-9" width="250" />
						<e:Label id="rank" text="第 1 名奖励: " size="24" textAlign="left" strokeColor="0x5E3500" stroke="1"
						         verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0" anchorOffsetY="0" textColor="0xFFFDE2"
						         scaleX="1" scaleY="1" y="4" x="5"/>
						<e:Scroller width="440" height="100" y="40" anchorOffsetY="0" anchorOffsetX="0">
							<e:List id="list" itemRendererSkinName="ItemSkin" width="414">
								<e:layout>
									<e:HorizontalLayout gap="25" paddingLeft="20" />
								</e:layout>
							</e:List>
						</e:Scroller>
					</e:Skin>
				</e:itemRendererSkinName>
				<e:layout>
					<e:VerticalLayout  gap="0"/>
				</e:layout>
			</e:List>
		</e:Scroller>

	</e:Group>
	<e:Group y="335" horizontalCenter="0">
		<e:Image source="form_hd_png" scale9Grid="40,34,20,32" x="0" y="0" anchorOffsetX="0" width="494" anchorOffsetY="0"
		         height="304.67" />
		<e:Image source="vip_line_png" x="5" y="65" width="480" />
		<e:Label text="活动积分排行榜" y="17.33" size="34" textAlign="left" strokeColor="0x5E3500" stroke="1" height="32"
		         verticalAlign="middle" fontFamily="Arial" x="128" anchorOffsetX="0" textColor="0xFFF135" />
		<e:Scroller width="459" height="210" y="76" anchorOffsetX="0" anchorOffsetY="0" horizontalCenter="0">
			<e:List id="point_list">
				<e:itemRendererSkinName>
					<e:Skin>
						<e:Label id="point" text="积分:2000" size="24" textAlign="left" strokeColor="0x5E3500" stroke="1"
						         verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0" anchorOffsetY="0" textColor="0x00FF00" x="316" />
						<e:Label id="rank" text="第5名: XXXXXX" size="24" textAlign="left" strokeColor="0x5E3500" stroke="1"
						         verticalAlign="middle" fontFamily="Arial" anchorOffsetX="0" anchorOffsetY="0" textColor="0xFFFDE2" />
					</e:Skin>
				</e:itemRendererSkinName>
				<e:layout>
					<e:VerticalLayout gap="10" />
				</e:layout>
			</e:List>
		</e:Scroller>
	</e:Group>
</e:Skin>