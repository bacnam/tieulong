		stroke="1" textColor="0xFFC446" width="120" height="30" verticalAlign="middle"
		touchEnabled="false" scaleX="1" scaleY="1" />
	<e:Image id="btn_buyAll" source="btn_bg3_png" x="56" y="598" scaleX="1" scaleY="1" />
	<e:Label text="Mua hết" x="107" y="613" size="26" textAlign="center" strokeColor="0x000000"
