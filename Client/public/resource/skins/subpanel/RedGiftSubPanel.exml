<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="RedGiftSubPanel" width="550" height="694" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing">
	<e:Scroller width="540" height="610" y="13.33" anchorOffsetX="0" anchorOffsetY="0" horizontalCenter="0">
		<e:List id="list" itemRendererSkinName="RedGiftItem">
