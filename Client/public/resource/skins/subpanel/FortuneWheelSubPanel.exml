			<e:Image source="from_cbg_png" scale9Grid="6,6,38,38" anchorOffsetX="0" width="101.13" anchorOffsetY="0" height="81.83" x="228.84999999999997" y="4.51" scaleX="1" scaleY="1"/>
			<e:Label id="draw_tip" text="再抽10次就可获得:" size="24" y="34.17" x="10" scaleX="1" scaleY="1" textColor="0xf7f4cd"/>
