						<e:Label id='time' y="75" size="20" textAlign="right" strokeColor="0x000000" stroke="1"
						         textColor="0x8D8D8D" height="30" verticalAlign="middle" scaleX="1" scaleY="1" x="330" right="24"/>
						<e:Label id='content' text="这个试测试数据这个试测试数据这个试测试数据这个试测试数据这个试测试数据这个试测试数据这个试测试数据这个试测试数据这个试测试数据这个试测试数据这个试测试数据这个试测试数据这个试测试数据这个试测试数据" y="12" size="20" textAlign="left" strokeColor="0x000000"
						         stroke="1" width="452" textColor="0xFFFFFF" height="52" verticalAlign="middle" horizontalCenter="0"
						         x="24" scaleX="1" scaleY="1" />
					</e:Skin>
				</e:itemRendererSkinName>
