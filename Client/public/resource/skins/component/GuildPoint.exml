	<e:Image id="img_namebg" y="104.5" source="form_gbg_png" anchorOffsetY="0" height="51" scale9Grid="74,5,10,32" horizontalCenter="-17.5"/>
	<e:Label id="label_guildname" text="Mỗ mỗ mỗ bang phái" y="118" stroke="1" size="24" horizontalCenter="-17.5"  bold="true" textColor="0x00ff00"/>
	<e:Button id="signup" label="Báo danh" width="88" bottom="6" x="0">
		<e:skinName>
			<e:Skin states="up,down,disabled">
				<e:Image width="100%" height="100%" source="btn_bg5_png" />
				<e:Label id="labelDisplay" size="20" stroke="1" textColor="0xF8F7D3" horizontalCenter="0" verticalCenter="0" />
