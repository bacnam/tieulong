<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="LimitGiftItem" width="460" height="160" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:component="legend.view.component.*">
	<e:Image source="form_hd_png" scale9Grid="40,34,20,32" anchorOffsetX="0" width="460" anchorOffsetY="0" height="160"/>
	<e:Label id="price" text="100000" x="359.32" y="32.37" size="22" textAlign="left" strokeColor="0x000000" stroke="1" anchorOffsetX="0" anchorOffsetY="0" textColor="0xF8F7D3"/>
	<e:Image id="price_icon" source="icon_crystal_png" x="313.65" y="18.04" width="40" height="40"/>
	<e:Image source="num_bg_png" scale9Grid="71,17,71,11" x="25" y="115.36" anchorOffsetX="0" width="428.33" anchorOffsetY="0" height="34"/>

	<e:Image source="vip_line_png" x="17.67" y="51.2" width="280"/>


	<e:Scroller width="150" height="100" x="146" y="45" anchorOffsetX="0">
		<e:List id="list" itemRendererSkinName="ItemSkin">
		<e:layout>
			<e:HorizontalLayout gap="15" paddingLeft="15"/>
		</e:layout>
		</e:List>
	</e:Scroller>
	<e:Image source="form_goldtit_png" x="6" y="68" anchorOffsetX="0" width="153"/>
	<e:Label id="title" text="Toàn dân đặc huệ" y="73.67" size="22" textAlign="left" strokeColor="0x5e3500" stroke="2" anchorOffsetX="0" anchorOffsetY="0" textColor="0xFFF135" horizontalCenter="-147"/>
	<e:Label id="buy_tip" text="Hôm nay mua sắm số lần: " y="124" size="18" textAlign="right" strokeColor="0x5E3500" stroke="1" verticalAlign="middle" fontFamily="Arial" textColor="0xF7F397" x="305" anchorOffsetX="0"/>
	<e:Label id="vipbuy_tip" text="VIP8 có thể mua: 1" y="125" size="18" textAlign="right" strokeColor="0x5E3500" stroke="1" verticalAlign="middle" fontFamily="Arial" textColor="0xF7F397" x="297.67" anchorOffsetX="0"/>


	<e:Label id="times" text="1" x="425" y="123" size="22" textAlign="left" strokeColor="0x000000" stroke="1" anchorOffsetX="0" anchorOffsetY="0" textColor="0xFF0000" bold="true"/>


	<e:Button id="btn_buy" label="Mua hàng" x="332" y="63.67" width="100">
		<e:skinName>
			<e:Skin states="up,down,disabled">
			<e:Image width="100%" height="100%" source="btn_bg4_png"/>
			<e:Label id="labelDisplay" size="24" horizontalCenter="0" verticalCenter="0" strokeColor="0x000000" stroke="1" textColor="0xF8F7D3" bold="true" touchEnabled="false"/>
			</e:Skin>
		</e:skinName>
	</e:Button>
	<e:Image id="img_over" source="1_png" x="311.51" y="78.89" rotation="339.13"/>
	<e:Image id="bg_discount" source="zhekou_png" x="275" y="6.04" touchEnabled="false"/>
	<e:BitmapLabel id="discount" text="8" y="13.68" verticalAlign="middle" horizontalCenter="68" font="shop_number_fnt" scaleX="0.48" scaleY="0.48" touchEnabled="false"/>
</e:Skin>