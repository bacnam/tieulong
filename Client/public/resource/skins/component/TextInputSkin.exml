<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="skins.TextInputSkin" minHeight="40" minWidth="300"
	states="normal,disabled,normalWithPrompt,disabledWithPrompt" xmlns:e="http://ns.egret.com/eui">
	<e:Image width="100%" height="100%" scale9Grid="1,3,8,8" />
	<e:EditableText id="textDisplay" verticalCenter="0" left="10" right="10" top="4"
		textColor.disabled="0x00ff00" width="100%" size="20" text="" textColor="0x000000"
		height="20" textAlign="center"/>
	<e:Label id="promptDisplay" verticalCenter="0" left="10" right="10" top="4"
		width="100%" size="20" touchEnabled="false" includeIn="normalWithPrompt,disabledWithPrompt"
		text="Vui lòng nhập" textColor="0xa6a7b6" height="20" textAlign="center"/>
</e:Skin>