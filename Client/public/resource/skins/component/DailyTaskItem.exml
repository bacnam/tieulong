		anchorOffsetX="0" />
	<e:Label id="schedule" text="0" y="9" size="20" textAlign="right" strokeColor="0x000000"
		stroke="1" textColor="0xF8F7D3" scaleX="1" scaleY="1" right="25" />
	<e:Label id="active" text="0" x="321" y="76" size="20" textAlign="left" strokeColor="0x000000"
		stroke="1" textColor="0xFFC446" height="30" verticalAlign="middle" scaleX="1" scaleY="1" />
	<e:Label id="rewardPrice" text="0" x="169" y="78" size="20" textAlign="left"
		strokeColor="0x000000" stroke="1" textColor="0xFFC446" height="30" verticalAlign="middle"
		scaleX="1" scaleY="1" />


	<e:Image id="img_active" source="vitality_png" x="280" y="72" scaleX="1" scaleY="1" />
